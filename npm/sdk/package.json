{
  "name": "@lumen-chain/sdk",
  "version": "0.10.1",
  "description": "Full-featured TypeScript/JavaScript SDK for the Lumen Cosmos SDK chain (queries, tx builders, PQC dual-sign support).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy_assets.mjs",
    "clean": "rimraf dist",
    "dev": "tsup --watch --onSuccess \"node scripts/copy_assets.mjs\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "gen:proto": "buf generate --template buf.gen.ts.yaml",
    "sync:proto": "bash scripts/sync_protos.sh",
    "pqc:build": "node scripts/pqc_build.mjs",
    "pqc:sync": "node scripts/pqc_sync.mjs",
    "prepare": "npm run build",
    "node:docker": "bash ../test-utils/docker_localnet.sh",
    "sdk:smoke": "npm run build && NODE_PATH=./node_modules node ../test-utils/sdk_smoke.mjs",
    "sdk:functional": "npm run build && NODE_PATH=./node_modules node ../test-utils/sdk_functional.mjs",
    "test:docker": "LUMEN_RELEASE_URL=https://github.com/network-lumen/blockchain/releases/download/v0.10.1/lumend-v0.10.1-linux-amd64.tar.gz bash ../test-utils/docker_test.sh",
    "copy:assets": "node scripts/copy_assets.mjs"
  },
  "keywords": [
    "cosmos",
    "sdk",
    "lumen",
    "pqc",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "esbuild": "^0.25.12"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@cosmjs/amino": "^0.33.0",
    "@cosmjs/encoding": "^0.33.0",
    "@cosmjs/math": "^0.33.0",
    "@cosmjs/proto-signing": "^0.33.0",
    "@cosmjs/stargate": "^0.33.0",
    "@cosmjs/tendermint-rpc": "^0.33.0",
    "@noble/hashes": "^1.8.0",
    "@noble/post-quantum": "^0.5.2",
    "bech32": "^2.0.0",
    "bip39": "^3.1.0",
    "long": "^5.2.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.49.0",
    "@types/node": "^20.14.15",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
